# Backend / POST /api/check read-only Monad RPC.
MONAD_RPC_URL=

# Local Kuru Live Smoke read-only RPC; not consumed by Backend automatically.
MOSS_RPC_URL=

# Expected Moss runtime identity for Backend / Agent Flow configuration.
# Bootstrap verifies it against the configured checkout before composing the app.
MOSS_RUNTIME_VERSION=
MOSS_RUNTIME_REVISION=

# Local built Moss Git checkout used by the live Backend Agent Flow and Live Smoke.
# Keep .git and ensure the runtime environment has the git executable: bootstrap
# reads HEAD to verify MOSS_RUNTIME_REVISION before the app or listener starts.
MOSS_RUNTIME_PATH=

# Configured token metadata JSON matching tokenRegistryConfigSchema.
PARALLAX_TOKEN_REGISTRY_JSON=

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Run lifecycle persistence backend. Keep memory for local/demo operation until
# a PostgreSQL database has been migrated and verified.
RUN_STORE_BACKEND=memory

# Required only when RUN_STORE_BACKEND=postgres. Never log this value.
DATABASE_URL=

# Required Node HTTP listener settings.
HOST=127.0.0.1
PORT=8787
