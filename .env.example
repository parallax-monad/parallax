# Backend / POST /api/check read-only Monad RPC.
MONAD_RPC_URL=

# Local Kuru Live Smoke read-only RPC; not consumed by Backend automatically.
MOSS_RPC_URL=

# Caller-provided Moss runtime identity for Backend / Agent Flow configuration.
# This is not independently verified Live provenance.
MOSS_RUNTIME_VERSION=
MOSS_RUNTIME_REVISION=

# Local built Moss checkout used by the live Backend Agent Flow and Live Smoke.
MOSS_RUNTIME_PATH=

# Configured token metadata JSON matching tokenRegistryConfigSchema.
PARALLAX_TOKEN_REGISTRY_JSON=

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Required Node HTTP listener settings.
HOST=127.0.0.1
PORT=8787
