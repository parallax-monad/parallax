# Monad RPC endpoint used for read-only calls and Moss integration.
MONAD_RPC_URL=

# Exact Moss runtime or portable baseline confirmed during integration.
MOSS_RUNTIME_VERSION=

# Immutable Moss commit, build digest, or deployed revision.
MOSS_RUNTIME_REVISION=

# Verified token metadata as a JSON object matching tokenRegistryConfigSchema.
PARALLAX_TOKEN_REGISTRY_JSON=

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Required Node HTTP listener settings.
HOST=127.0.0.1
PORT=8787
