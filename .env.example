# Current public product path: Arbitrum Sepolia × Camelot V3.
# Arbitrum Sepolia RPC used by the Backend Camelot composition.
ARBITRUM_RPC_URL=

# Trusted token metadata JSON matching tokenRegistryConfigSchema.
PARALLAX_TOKEN_REGISTRY_JSON=

# Optional Tenderly Arbitrum simulation provider. Set all three values to
# enable Tenderly; otherwise the Arbitrum composition uses NativeRpcProvider.
# Never commit or log the access key.
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_ACCESS_KEY=
TENDERLY_TIMEOUT_MS=10000

# Legacy shared Backend configuration. API startup currently still validates these
# values on the Arbitrum path; this does not make Monad/Kuru/Moss the current product path.
# MONAD_RPC_URL must be a syntactically valid HTTP(S) URL.
MONAD_RPC_URL=

# Non-empty legacy runtime identity values required by local API bootstrap validation.
# A Moss checkout is not needed for local Arbitrum development; the current Dockerfile
# still clones/builds its pinned Moss runtime and sets MOSS_RUNTIME_PATH for deployment.
MOSS_RUNTIME_VERSION=
MOSS_RUNTIME_REVISION=

# Optional local built Moss Git checkout for the historical live Agent Flow. If set,
# keep .git and the git executable available; bootstrap verifies HEAD against the
# configured MOSS_RUNTIME_REVISION before starting the app or listener.
MOSS_RUNTIME_PATH=

# Optional local Kuru Live Smoke read-only RPC; not consumed by Backend automatically.
MOSS_RPC_URL=

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Run lifecycle persistence backend. Keep memory for local/demo operation until
# a PostgreSQL database has been migrated and verified.
RUN_STORE_BACKEND=memory

# Required only when RUN_STORE_BACKEND=postgres. Use a direct Neon host without
# the `-pooler` suffix because startup migrations use session advisory locks.
# Never log this value.
DATABASE_URL=

# Required Node HTTP listener settings.
HOST=127.0.0.1
PORT=8787
