{
  "name": "parallax",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "smoke:kuru": "node scripts/chain-smoke/kuru.ts",
    "smoke:kuru:live": "vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@parallax/moss-bridge": "workspace:*",
    "@types/node": "22.13.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
